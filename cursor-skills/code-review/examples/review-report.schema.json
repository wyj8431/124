{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code review report",
  "type": "object",
  "required": ["schemaVersion", "scope", "summary", "files", "findings", "verification"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "scope": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["total", "bySeverity", "byCategory"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "bySeverity": { "type": "object" },
        "byCategory": { "type": "object" }
      }
    },
    "files": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "file", "line", "title", "evidence", "recommendation"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "enum": ["high", "medium", "low", "info"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["commands", "status"],
      "properties": { "commands": { "type": "array" }, "status": { "type": "string" } }
    }
  }
}
